# Copy this file to .env and fill in your values.
# cp .env.example .env

# --- LLM agent (required for chat + explanations) ---
# DeepSeek is OpenAI-compatible: same env vars, DeepSeek endpoint/model.
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# --- Backend API URL (used by the Streamlit frontend) ---
API_BASE_URL=http://127.0.0.1:8001

# --- Optional data/model paths (defaults are fine if you keep the repo layout) ---
BASELINE_ARTIFACT_DIR=outputs/baseline_engine
PROMOTION_DATA_DIR=data/raw
CANNIBALIZATION_ARTIFACT_DIR=outputs/cannibalization_detection

# --- Optional: cap rows returned by the LLM SQL agent ---
# LLM_MAX_QUERY_ROWS=200
